# Security Mail Analyzer - 환경변수 예시
# 이 파일을 .env로 복사하여 실제 값으로 설정하세요

# Gmail 설정
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"
GMAIL_QUERY="subject:security OR subject:alert OR subject:warning"
GMAIL_LABEL_IDS="[]"

# Ollama LLM 설정 (NVIDIA GB10)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"

# SMTP 설정 (리포트 발송)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# 리포트 수신자 (JSON 배열)
REPORT_RECIPIENTS='["admin@company.com"]'

# 외부 API 키 (선택사항 - IP 위협 정보)
ABUSEIPDB_API_KEY="your-abuseipdb-key"
IPINFO_TOKEN="your-ipinfo-token"
