# ============================================================
# Security Mail Analyzer - 환경변수 예시
# 이 파일을 복사하여 .env 로 사용하세요: cp .env.example .env
# ============================================================

# ── PostgreSQL DB ──────────────────────────────────────────
POSTGRES_DB=secmail
POSTGRES_USER=secmail
POSTGRES_PASSWORD=your_strong_password_here
# docker-compose 사용 시 자동 설정 (수정 불필요)
# DATABASE_URL=postgresql+asyncpg://secmail:password@localhost:5432/secmail

# ── Gmail 설정 ─────────────────────────────────────────────
# Gmail 앱 비밀번호: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
# 검색 쿼리 (Gmail 검색 문법)
GMAIL_QUERY=subject:security OR subject:alert OR subject:warning
# 라벨 ID 목록 (JSON 배열, 비워두면 전체 메일함)
GMAIL_LABEL_IDS=[]

# ── Ollama LLM 설정 ────────────────────────────────────────
# 도커 사용 시 http://localhost:11434 (host network)
OLLAMA_URL=http://localhost:11434
# 사용할 모델 (도커 초기화 시 자동 설치: gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# ── SMTP 설정 (리포트 발송) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp@gmail.com
SMTP_PASSWORD=your_smtp_app_password

# ── 리포트 수신자 ──────────────────────────────────────────
# JSON 배열 형식
REPORT_RECIPIENTS=["admin@example.com","security@example.com"]

# ── 외부 IP 조회 API (선택) ────────────────────────────────
# AbuseIPDB: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=
# IPInfo: https://ipinfo.io/account/token
IPINFO_TOKEN=

# ── PostgreSQL 포트 (host network) ─────────────────────────
# 기본 5432 사용, 충돌 시 변경
# POSTGRES_PORT=5432
